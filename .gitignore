# Runtime state: accounts, session key and generated TLS certificates.
data/

# User-created profiles are runtime data, not source. The directories are kept
# (via .gitkeep) so a fresh clone has the tree the server expects.
Profiles/private/*
Profiles/shared/*
!Profiles/private/.gitkeep
!Profiles/shared/.gitkeep

# User-authored function modules, likewise -- the examples are tracked.
Functions/*
!Functions/examples/
!Functions/examples/**

config.toml

__pycache__/
*.py[cod]
.pytest_cache/
*.tmp
